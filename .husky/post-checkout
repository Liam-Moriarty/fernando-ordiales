

PREV_HEAD=$1
NEW_HEAD=$2
IS_BRANCH_CHECKOUT=$3

# Only run on branch checkouts (not file checkouts)
if [ "$IS_BRANCH_CHECKOUT" = "1" ]; then
  echo "🔀 Branch switched. Checking dependencies..."

  CHANGED=$(git diff --name-only $PREV_HEAD $NEW_HEAD)

  if echo "$CHANGED" | grep -q "pnpm-lock.yaml"; then
    echo "📦 Lockfile changed. Reinstalling..."
    pnpm install
  fi
fi