# .editorconfig — works in ALL editors automatically
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.{ts,tsx,js,jsx}]
indent_size = 2
max_line_length = 80

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.json]
indent_size = 2

[Makefile]
indent_style = tab